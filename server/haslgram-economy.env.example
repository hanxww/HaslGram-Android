# HaslGram server economy — DEPLOYMENT TEMPLATE ONLY.
# Apply these values to the actual HaslGram MTProto server deployment.
# They are not read by the Android APK and this file does NOT change any live account.
#
# Confirm that your deployed server implements the OwpenGram/gramsrv
# TELESRV_* settings before applying.

# One-time, idempotent server-authoritative Stars credit per account.
# CAUTION: OwpenGram implementation gives a lazy one-time grant to ALL
# accounts that have not received one, including existing users on next access.
TELESRV_STARS_STARTING_GRANT=2000

# Newly registered accounts must not receive complimentary Premium months.
# This does not revoke Premium already assigned to existing accounts.
TELESRV_PREMIUM_GRANT_MONTHS=0

# Optional: verified official gift snapshot path for explicit admin import.
# An actual snapshot and operator import are still required before gifts appear.
# Do not use Telegram assets without verifying licensing/redistribution rights.
TELESRV_OFFICIAL_GIFTS_DIR=data/official-gifts
